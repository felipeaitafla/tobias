---
/*
 * A política de privacidade, em português.
 *
 * O caminho é o mesmo que o rodapé já apontava antes desta página existir
 * (`rodape.legais` no Sanity) — mudar o nome do arquivo aqui quebra aquele link
 * sem quebrar o build.
 *
 * Existe versão inglesa desde 2026-08-12 (`src/pages/en/privacy-policy.astro`,
 * documento `legal-privacidade-en`) — por isso o `rotas` lista os dois
 * idiomas, e não só o pt-BR: é o que fecha o `hreflang` nos dois sentidos.
 */
import Legal from '../layouts/Legal.astro';
---

<Legal
  chave="privacidade"
  idioma="pt-BR"
  rotas={{ 'pt-BR': '/politica-de-privacidade', en: '/en/privacy-policy' }}
/>
