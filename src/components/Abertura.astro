---
/*
 * Animação de abertura.
 *
 * Sequência:
 *  1. Tela cheia em azul petróleo, símbolo centralizado.
 *  2. As quatro barras entram da direita para a esquerda. Cada uma nasce
 *     deitada na posição da barra 1 (a horizontal da esquerda) e gira em torno
 *     da própria base até o seu ângulo. A barra 1 não gira — já está no lugar.
 *  3. O símbolo desliza para a esquerda até sua posição na assinatura, e o
 *     letreiro é revelado da esquerda para a direita, saindo de trás dele.
 *  4. Pausa e revelação do hero.
 *
 * Os números de base/ângulo vêm da geometria do próprio SVG (logo-hero.svg):
 * cada barra tem ~36 unidades e o leque abre em passos de ~40°.
 *
 * É CSS puro de propósito: sem JS, a animação roda igual, e o hero já está no
 * DOM por baixo desde o início — nada de conteúdo bloqueado por script.
 */
---

<div class="abertura" aria-hidden="true">
  <div class="abertura__cortina">
    <div class="abertura__painel">
      <svg class="abertura__logo" viewBox="0 0 361 50" fill="none" xmlns="http://www.w3.org/2000/svg">
    <g class="abertura__simbolo">
      <path
        class="barra barra--1"
        d="M1.88025 47.1053L3.00273 44.6387L39.663 44.6732L38.5406 47.1398L1.88025 47.1053Z"
        fill="white"
      />
      <path
        class="barra barra--2"
        d="M11.0463 18.3198L14.6657 16.5903L42.2991 40.3062L38.6797 42.0376L11.0463 18.3198Z"
        fill="white"
      />
      <path
        class="barra barra--3"
        d="M35.9835 1.91943L41.1334 3.31877L47.2723 39.0586L42.1243 37.6573L35.9835 1.91943Z"
        fill="white"
      />
      <path
        class="barra barra--4"
        d="M65.4858 5.30542L69.3158 10.8701L51.7979 41.7804L47.9679 36.2157L65.4858 5.30542Z"
        fill="white"
      />
    </g>

    <g class="abertura__letreiro">
      {/* Fixa a caixa de referência do clip-path em 0 0 361 50. Sem isto o
          inset() mediria contra o bbox das letras, que muda se o desenho mudar. */}
      <rect x="0" y="0" width="361" height="50" fill="none" />
      <path
        d="M230.39 26.0423C214.148 13.335 224.835 7.25196 232.384 10.4384C235.067 11.5709 237.089 13.1776 237.67 13.6862L237.286 8.88356C219.018 3.77185 212.257 14.9896 220.643 24.3876C223.737 27.8543 238.634 37.2447 232.04 43.9765C225.619 50.5317 218.157 43.1357 216.69 41.8554L217.074 46.6581C218.836 46.9978 233.035 51.5413 238.177 42.293C241.874 35.6438 232.213 27.4685 230.391 26.0423H230.39Z"
        fill="white"
      />
      <path d="M109.229 8.37866H85.1772V10.8932H94.6197V47.1398H99.7883V10.8932H109.229V8.37866Z" fill="white" />
      <path d="M182.444 8.37866H177.276V47.1398H182.444V8.37866Z" fill="white" />
      <path
        d="M162.529 23.6428V23.591C167.463 22.9614 168.388 21.944 169.26 21.0879C169.924 20.4372 170.4 19.7193 170.689 18.938C170.979 18.1568 171.123 17.3564 171.123 16.5406C171.123 15.3063 170.898 14.1853 170.447 13.1775C169.995 12.1698 169.298 11.3098 168.352 10.5977C167.408 9.88553 166.199 9.33846 164.727 8.95456C163.255 8.57257 161.497 8.38062 159.455 8.38062H146.544V47.1417H159.658C162.364 47.1417 164.644 46.8423 166.5 46.2434C168.356 45.6445 169.858 44.8229 171.007 43.7806C172.156 42.7383 172.985 41.5137 173.496 40.1047C174.008 38.6977 174.262 37.1851 174.262 35.5689C174.262 32.3364 173.305 29.7258 171.389 27.7353C169.475 25.7447 166.543 24.234 162.525 23.6428H162.529ZM151.714 10.9336H156.315C157.849 10.9336 159.229 11.0238 160.455 11.2023C161.683 11.3808 162.725 11.6841 163.584 12.1103C164.443 12.5364 165.101 13.1027 165.562 13.8091C166.022 14.5154 166.252 15.3888 166.252 16.4292C166.252 17.5541 165.996 18.4985 165.485 19.2663C164.973 20.0322 164.274 20.6503 163.385 21.1186C162.495 21.587 161.448 21.9287 160.241 22.1417C159.034 22.3548 157.725 22.4604 156.315 22.4604H151.714V10.9336ZM167.32 39.0835C166.842 40.2583 166.15 41.2565 165.244 42.0742C164.338 42.8938 163.212 43.5157 161.865 43.9438C160.519 44.3719 158.977 44.5849 157.238 44.5849H151.714V24.7696H153.51C155.715 24.7696 157.716 24.975 159.511 25.3838C161.307 25.7927 162.834 26.4165 164.097 27.2535C165.359 28.0904 166.331 29.1634 167.013 30.4706C167.696 31.7797 168.036 33.323 168.036 35.1044C168.036 36.5824 167.797 37.9088 167.322 39.0835H167.32Z"
        fill="white"
