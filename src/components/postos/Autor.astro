---
/*
 * A pílula do Thiago (#373:164): rosto, nome e OAB, num link para o "Quem
 * conduz" da landing.
 *
 * Saiu do hero em 2026-10-15, quando a página de artigo passou a assinar com
 * ela também — duas cópias divergiriam na primeira vez que alguém acertasse uma
 * só.
 */
import { imagem, type ImagemSanity } from '../../lib/imagem';

interface Props {
  /* A foto do Thiago, do Sanity — a mesma do "Quem conduz". */
  foto: ImagemSanity;
  nome: string;
  registro: string;
  href: string;
  /* O prefixo antes do nome ("Por", no artigo). Fica fora do negrito. */
  prefixo?: string;
}

const { foto, nome, registro, href, prefixo } = Astro.props;

/*
 * A pílula mostra só o rosto (#373:161, 36px). O arquivo do Figma é o retrato
 * original (2067×3100) e o do Sanity, um recorte dele na mesma escala,
 * deslocado em (59, 285) — achado comparando os dois pixel a pixel. Levada
 * para o arquivo do Sanity, a janela do Figma é um quadrado de 1166px em
 * (308, −77): começa ACIMA da foto. O recorte encosta no topo, e o rosto sai
 * ~2px mais alto na pílula do que no arquivo; o tamanho dele é o mesmo.
 *
 * `sizes` acompanha os 2.25rem do CSS (27 a 63px com o clamp da raiz) — um px
 * cravado mentiria fora da largura de projeto.
 */
const retrato = imagem(foto, {
  larguras: [72, 144],
  sizes: 'clamp(27px, 2.49vw, 63px)',
  recorte: { x: 0.1744, y: 0, largura: 0.661, altura: 0.5891 },
});
---

{/* `alt` vazio: o nome está escrito logo ao lado, e um `alt` com ele faria o
    leitor de tela dizê-lo duas vezes.

    Numa linha só: com o texto na linha de baixo, o Astro come o espaço entre
    as tags e sai "Thiago Tobias•". */}
<a class="autor" href={href}>
  <img
    class="autor__retrato"
    src={retrato.src}
    srcset={retrato.srcset}
    sizes={retrato.sizes}
    width={retrato.width}
    height={retrato.height}
    alt=""
    loading="eager"
  />
  <span>{prefixo && `${prefixo} `}<strong class="autor__nome">{nome}</strong> <span class="autor__registro">• {registro}</span></span>
</a>

<style>
  /*
   * Bege, raio de 100 (que é "redondo até a ponta" em qualquer altura), e o
   * respiro assimétrico do arquivo — 4px em volta da foto, 20 depois do texto.
   *
   * O bege é o `--cor-bege-claro`, o mesmo do fundo das credenciais.
   *
   * Inter 16/1.5/-0.05em; o nome em Semi Bold, o resto Regular. Piso de 14px,
   * o mesmo do `--texto-apoio`.
   */
  .autor {
    display: inline-flex;
    align-items: center;
    gap: 0.5625rem; /* 9px */
    padding: 0.25rem 1.25rem 0.25rem 0.25rem; /* 4 20 4 4 */
    border-radius: 6.25rem; /* 100px */
    font: 400 max(1rem, 14px) / 1.5 var(--fonte-corpo);
    letter-spacing: -0.05em;
    white-space: nowrap;
    color: var(--cor-preto);
    background: var(--cor-bege-claro);
  }

  .autor strong {
    font-weight: var(--peso-destaque);
  }

  /*
   * O hover é o dos cartões de artigo (pedido do cliente, 2026-10-09): o nome
   * no petróleo da marca, a OAB no mesmo petróleo mais claro. Cor, e não
   * `opacity`, como em todo hover do site.
   */
  .autor__nome,
  .autor__registro {
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .autor:hover .autor__nome {
      color: var(--cor-petroleo);
    }

    .autor:hover .autor__registro {
      color: rgb(60 117 124 / 0.8); /* o --cor-petroleo a 0.8 */
    }
  }

  /* 36px, redondo (#373:161). Tamanho cravado nas duas medidas e `cover`: a
     proporção do recorte é quadrada hoje, mas a foto é trocável no Studio. */
  .autor__retrato {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
