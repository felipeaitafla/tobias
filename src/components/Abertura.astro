        fill="white"
      />
      <path
        d="M198.21 8.37866H192.236L194.617 13.6305L185.184 47.1398H187.833L189.55 40.7074H193.272L206.906 40.7113L209.822 47.1398H215.662L198.212 8.37866H198.21ZM190.161 38.4002L195.976 16.6211L205.857 38.4002H190.162H190.161Z"
        fill="white"
      />
      <path
        d="M274.163 8.37866H268.189L270.569 13.6305L261.136 47.1398H263.786L265.502 40.7074H269.225L282.859 40.7113L285.775 47.1398H291.615L274.164 8.37866H274.163ZM266.113 38.4002L271.929 16.6211L281.809 38.4002H266.115H266.113Z"
        fill="white"
      />
      <path
        d="M327.288 27.7199C327.288 30.4303 326.816 32.964 325.87 35.3174C324.926 37.6727 323.526 39.7266 321.67 41.4829C319.814 43.2374 317.513 44.6194 314.764 45.6272C312.015 46.635 308.835 47.1398 305.227 47.1398H294.35V8.37866H305.227C308.835 8.37866 312.015 8.8835 314.764 9.88933C317.513 10.8971 319.816 12.2753 321.67 14.0202C323.526 15.7669 324.924 17.817 325.87 20.1723C326.816 22.5275 327.288 25.0421 327.288 27.718V27.7199ZM321.365 27.8255C321.365 25.4625 321.1 23.4028 320.574 21.6484C320.045 19.8939 319.331 18.3909 318.428 17.1394C317.526 15.8879 316.471 14.859 315.262 14.0509C314.053 13.2428 312.776 12.6093 311.432 12.1486C310.088 11.6879 308.704 11.3712 307.282 11.1965C305.861 11.0238 304.477 10.9355 303.133 10.9355H299.942V44.5868H303.133C304.477 44.5868 305.861 44.5004 307.282 44.3258C308.704 44.153 310.088 43.8344 311.432 43.3737C312.776 42.913 314.053 42.2834 315.262 41.4848C316.471 40.6863 317.526 39.6651 318.428 38.4213C319.331 37.1793 320.045 35.6879 320.574 33.9507C321.1 32.2135 321.365 30.1711 321.365 27.8255Z"
        fill="white"
      />
      <path
        d="M344.618 43.6174L346.047 47.1398H340.021L324.855 8.37866H330.727L343.356 40.3351L356.519 8.37866H359.12L344.637 43.5714L344.618 43.6174Z"
        fill="white"
      />
      </g>
      </svg>
    </div>

    {/* Rastro da paleta: acompanha a borda direita do painel e encolhe junto
        com o movimento, como nos slides 2→4 do Figma. */}
    <div class="abertura__faixas">
      <span class="faixa faixa--terracota"></span>
      <span class="faixa faixa--bege"></span>
      <span class="faixa faixa--cinza"></span>
      <span class="faixa faixa--branco"></span>
    </div>
  </div>
</div>

<style>
  .abertura {
    /* Tempos concentrados aqui para facilitar ajuste fino. `--giro`/`--passo`/
       `--t1` vêm de `--simbolo-giro`/`--simbolo-passo`/`--simbolo-t1`
       (tokens.css): o mesmo ritmo que `simbolo.css` usa para montar o símbolo
       do manifesto e das áreas, num SVG diferente (`<path>`, não `<polygon>`)
       — os dois precisam ficar em sincronia. */
    --giro: var(--simbolo-giro);
    --passo: var(--simbolo-passo);
    --t1: var(--simbolo-t1); /* barra 4, a mais à direita, abre a sequência */
    --t2: calc(var(--t1) + var(--passo));
    --t3: calc(var(--t2) + var(--passo));
    --t4: calc(var(--t3) + var(--passo));
    --montagem: 1.25s; /* símbolo pronto → começa a deslocar */
    --deslize: 0.75s;
    --espera: 0.5s;
    --transicao: 1.1s; /* cortina saindo para a esquerda */
    --fim: calc(var(--montagem) + var(--deslize) + var(--espera));
    --curva: cubic-bezier(0.65, 0, 0.35, 1);

    position: fixed;
    inset: 0;
    z-index: 100;
    /* Sem fundo próprio: quem cobre a tela é o painel. Assim, conforme a
       cortina sai, o hero aparece por baixo sem precisar de fade. */
    overflow: hidden;
    animation: abertura-encerrar 0s linear calc(var(--fim) + var(--transicao))
      forwards;
  }

  .abertura__cortina {
    display: flex;
    width: max-content;
    height: 100%;
    animation: cortina-sair var(--transicao) var(--curva) var(--fim) forwards;
  }

  .abertura__painel {
    display: grid;
    place-items: center;
    width: 100vw;
    height: 100%;
    background: var(--cor-petroleo);
  }

  /*
   * Encolhe pelo container, não faixa a faixa. Duas razões: o Figma reduz as
   * quatro na mesma proporção (×0,428 do slide 2 para o 3), que é o que uma
   * escala uniforme faz; e scaleX roda na GPU, enquanto animar `width` em
   * quatro elementos forçaria layout a cada quadro.
   * A origem à esquerda mantém as faixas coladas na borda do painel.
   */
  .abertura__faixas {
    display: flex;
    height: 100%;
    transform-origin: left center;
    animation: faixas-encolher var(--transicao) var(--curva) var(--fim) forwards;
  }

  .faixa {
    height: 100%;
    /* Larguras na proporção do slide 2 do Figma (262:221:157:92). */
  }

  .faixa--terracota {
    width: 18.1vw;
    background: #c1503b;
  }

  .faixa--bege {
    width: 15.3vw;
    background: var(--cor-bege);
  }

  .faixa--cinza {
    width: 10.9vw;
    background: var(--cor-cinza-claro);
  }

  .faixa--branco {
    width: 6.4vw;
    background: var(--cor-branco);
  }

  .abertura__logo {
    /* 800px na largura de projeto (1446). A proporção é a do próprio arquivo:
       só a largura muda, a altura acompanha. */
    width: min(50rem, 86vw);
    height: auto;
    overflow: visible;
  }

  /* Pedido do cliente, 2026-07-31: logo menor no mobile, com 32px de respiro
     de cada lado — os 86vw de cima (322px numa tela de 375px, só 26px de
     folga) davam pouco espaço. */
  @media (max-width: 700px) {
    .abertura__logo {
      width: calc(100vw - 64px);
    }
  }

  /* O símbolo nasce centralizado na tela: deslocado para a direita pela
     distância entre o centro do símbolo (x≈35,6) e o centro da assinatura
     (x=180,5). Depois volta a zero, que é seu lugar definitivo. */
  .abertura__simbolo {
    transform: translateX(144.9px);
    animation: simbolo-encaixar var(--deslize) cubic-bezier(0.65, 0, 0.35, 1)
      var(--montagem) forwards;
  }

  .barra {
    transform-box: view-box;
    opacity: 0;
    animation: barra-abrir var(--giro) cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  /* Cada barra gira em torno da própria base e parte da posição da barra 1:
     o translate leva sua base até a base da barra 1, o rotate a deita. */
  .barra--4 {
    transform-origin: 49.89px 39px;
    transform: translate(-10.79px, 6.91px) rotate(-119.54deg);
    animation-delay: var(--t1);
  }

  .barra--3 {
    transform-origin: 44.7px 38.36px;
    transform: translate(-5.6px, 7.55px) rotate(-80.25deg);
    animation-delay: var(--t2);
  }

  .barra--2 {
    transform-origin: 40.49px 41.18px;
    transform: translate(-1.39px, 4.73px) rotate(-40.65deg);
    animation-delay: var(--t3);
  }

  /* A barra 1 é a referência: já está deitada no lugar certo, só aparece. */
  .barra--1 {
    transform-origin: 39.1px 45.91px;
    animation-name: barra-surgir;
    animation-duration: 0.3s;
    animation-delay: var(--t4);
  }

  /*
   * O letreiro sai de trás do símbolo. A borda ESQUERDA do corte acompanha
   * exatamente a borda direita do símbolo (que vai de 214,22 a 69,32 conforme
   * ele desliza), enquanto a borda DIREITA avança até o fim da assinatura.
   * Por isso mesma duração, atraso e curva do deslize — se divergirem, as
   * letras aparecem por cima das barras.
   *
   *   início: faixa de largura zero em x=214,22 (borda direita do símbolo)
   *   fim...: x de 69,32 a 361 (assinatura inteira)
   */
  .abertura__letreiro {
    clip-path: inset(0 146.78px 0 214.22px);
    animation: letreiro-revelar var(--deslize) cubic-bezier(0.65, 0, 0.35, 1)
      var(--montagem) forwards;
  }

  @keyframes barra-abrir {
    from {
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    to {
      opacity: 1;
      transform: translate(0, 0) rotate(0deg);
    }
  }

  @keyframes barra-surgir {
    to {
      opacity: 1;
    }
  }

  @keyframes simbolo-encaixar {
    to {
      transform: translateX(0);
    }
  }

  @keyframes letreiro-revelar {
    to {
      /* 69,32 é onde o símbolo para; não corta letra nenhuma (começam em 85,18). */
      clip-path: inset(0 0 0 69.32px);
    }
  }

  @keyframes cortina-sair {
    to {
      /* 100vw tira o painel da tela; a sobra cobre as faixas, que a essa
         altura já encolheram a zero. */
      transform: translateX(-105vw);
    }
  }

  @keyframes faixas-encolher {
    to {
      transform: scaleX(0);
    }
  }

  @keyframes abertura-encerrar {
    to {
      visibility: hidden;
    }
  }

  /* Sem animação: mostra o hero direto, sem tela intermediária. */
  @media (prefers-reduced-motion: reduce) {
    .abertura {
      display: none;
    }
  }
</style>
