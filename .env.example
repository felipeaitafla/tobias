# Copie para `.env` e preencha. O `.env` está no .gitignore — segredo nenhum
# entra no repositório.
#
# As duas primeiras são PUBLIC_ porque identificam o projeto, não dão acesso: o
# dataset `production` tem ACL pública, então LER não pede token. É por isso que
# o build do site não precisa de credencial nenhuma.
PUBLIC_SANITY_PROJECT_ID=b4ibcfka
PUBLIC_SANITY_DATASET=production

# ESTE é segredo. Usam-no os scripts que ESCREVEM no Sanity — o Studio autentica
# pelo login, e o site só lê. Gere em sanity.io/manage → API → Tokens, com
# permissão de Editor. Se um token vazar, revogue-o lá mesmo.
SANITY_WRITE_TOKEN=

# Prévia de rascunho no `npm run dev`: com `true`, o site mostra o que ainda não
# foi publicado (usa o token acima). É o que deixa VER uma edição antes de
# decidir publicá-la — sem isto, publicar é a única forma de olhar.
#
# Deixe VAZIO para build. Ligada num build, o `dist/` sai com texto não
# publicado, e por isso ela não vai para o painel da hospedagem.
SANITY_RASCUNHOS=

# --- A função do pedido da apresentação (servidor/apresentacao.ts) ---
#
# Estas duas NÃO entram no build do site: quem as lê é a função, no servidor da
# hospedagem. Preencha as mesmas variáveis no painel da Vercel/Netlify — sem
# elas a função responde 503 e o bloco avisa que o e-mail não saiu (o download
# continua acontecendo).
#
# A chave sai de resend.com → API Keys.
RESEND_API_KEY=

# O endereço de onde o e-mail sai. TEM que ser de um domínio verificado no
# Resend (resend.com → Domains): remetente de domínio não verificado é recusado
# no envio, ou cai direto no spam de quem receber.
# Ex.: Tobias Advogados <apresentacao@tobiasadv.com.br>
EMAIL_REMETENTE=
